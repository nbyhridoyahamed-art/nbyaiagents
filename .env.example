# ─────────────────────────────────────────────────────────────────────────────
# NBY AI Agents — environment template
# Copy to `.env` and fill in values. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (used in emails, webhook URLs, signed links)
APP_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ works. For local development without Postgres installed,
# `npm run db:start` launches an embedded PostgreSQL on DEV_DB_PORT.
DEV_DB_PORT=5433
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nby?schema=public"

# ── Queue ───────────────────────────────────────────────────────────────────
# When set, background jobs use BullMQ on Redis. When empty, a durable
# PostgreSQL-backed queue is used (FOR UPDATE SKIP LOCKED).
REDIS_URL=""
# The web server runs a background worker in-process unless this is "false"
# (then run `npm run worker` separately — recommended in production).
EMBEDDED_WORKER="true"

# ── Security ────────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Random string used to sign short-lived URLs (file downloads, etc.)
SIGNING_SECRET=""

# ── AI providers (all optional) ─────────────────────────────────────────────
# Without any key, agents run on the "Offline demo model", which is clearly
# labelled in the UI and never pretends to be a real AI model.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""
# Any OpenAI-compatible endpoint (e.g. a local model server)
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_MODEL=""
# Free tiers / open models (optional platform-wide keys; each company can also
# connect its own in Settings → AI providers). *_MODEL sets the default model id.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""
GROQ_API_KEY=""
GROQ_MODEL=""
CEREBRAS_API_KEY=""
CEREBRAS_MODEL=""
MISTRAL_API_KEY=""
MISTRAL_MODEL=""
# Ollama: your own server (must be reachable from the app) or https://ollama.com/v1 with a key
OLLAMA_BASE_URL=""
OLLAMA_API_KEY=""
OLLAMA_MODEL=""

# ── Email ───────────────────────────────────────────────────────────────────
# "console" (development: logs messages), "resend", or "file" (writes each
# message to EMAIL_FILE_DIR — only allowed when APP_URL is localhost; used by E2E tests)
EMAIL_PROVIDER="console"
EMAIL_FILE_DIR=".data/mailbox"
EMAIL_FROM="NBY AI Agents <no-reply@example.com>"
RESEND_API_KEY=""

# ── Storage ─────────────────────────────────────────────────────────────────
# "local" stores files under STORAGE_LOCAL_DIR. Object storage adapters plug
# into lib/storage (see README).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR=".data/storage"

# ── Real integrations (all optional; each shows "Not configured" until set) ──
# Google Workspace (Gmail, Calendar, Sheets) — one OAuth app covers all three.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: {APP_URL}/api/integrations/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# HubSpot CRM — HubSpot Developer account → App → Auth.
# Redirect URL: {APP_URL}/api/integrations/hubspot/callback
HUBSPOT_OAUTH_CLIENT_ID=""
HUBSPOT_OAUTH_CLIENT_SECRET=""
# Web Search (Tavily) — one platform-wide key shared by every org, from app.tavily.com.
TAVILY_API_KEY=""
# Shopify needs no platform key: each org pastes its own store's Admin API
# access token (Shopify admin → Settings → Apps → Develop apps → your app).

# ── Network safety ──────────────────────────────────────────────────────────
# Custom REST tools are blocked from private/loopback/link-local addresses
# (SSRF protection). Only enable for local development against local APIs.
ALLOW_PRIVATE_NETWORK_TOOLS="false"
# How many proxies in front of the app append to X-Forwarded-For (rate limits
# and audit use the address the outermost trusted proxy saw). Always deploy
# behind at least one proxy — client-supplied X-Forwarded-For is never trusted.
TRUSTED_PROXY_HOPS="1"
# Test-only: multiplies every rate limit (e.g. 20 for end-to-end tests). Leave unset in production.
# RATE_LIMIT_SCALE=""

# ── Local demo admin (npm run demo:admin) ───────────────────────────────────
# Leave the password empty to have one generated into your .env.
DEMO_ADMIN_EMAIL="admin@nby.test"
DEMO_ADMIN_PASSWORD=""
